{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "pages/**/*.ts", "pages/**/*.tsx", "pages/notes.js", "components/GAP/Tiles/AssignTileMini.tsx", "components/GAP/Tiles/TaskTileMini.tsx", "components/GAP/Tiles/WorkerTileMini.tsx", "components/GAP/Tiles/LabelTilesMini.tsx", "components/GAP/Tiles/EmptyTilesMini.tsx", "components/GAP/InstructionGAPWrapper.tsx"],
  "exclude": ["node_modules"]
}
