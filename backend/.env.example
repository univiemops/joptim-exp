# Copy to backend/.env and adjust. The `.env` file itself is gitignored and
# must never be committed. The values below are dummy defaults for local
# development; a production deployment chooses its own secret values.

# PostgreSQL connection used by the backend
DATABASE_URL=postgresql://user:pass@db/db

# Local directories for collected data (relative to the backend)
EYETRACKING_DATA_DIR=eyetracking_data
RRWEB_DATA_DIR=rrweb_data

# Prolific completion URL; a production deployment uses its own completion code
COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=YOUR_COMPLETION_CODE

# Secret path prefix for the data-download endpoints (choose a private value
# for a deployment; download clients put it in JOPTIM_API_KEY)
DOWNLOAD_URI=download
